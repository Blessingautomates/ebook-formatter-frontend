# Where the FastAPI backend is listening. Requests to /api/* are proxied here,
# so this is read by the Next.js server, not the browser.
BACKEND_ORIGIN=http://127.0.0.1:8000

# The Supabase project behind sign-in and the saved-projects list. Both values
# are in the dashboard under Project Settings -> API.
#
# They are NEXT_PUBLIC_ because the browser talks to Supabase directly, and so
# both are visible to anyone who loads the site. That is by design: the anon key
# only names the project, and the row-level security in supabase/schema.sql is
# what stops one account reading another's manuscripts. Never put the
# service-role key here, or in any other NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
