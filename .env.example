# Where the FastAPI backend is listening. Requests to /api/* are proxied here,
# so this is read by the Next.js server, not the browser.
BACKEND_ORIGIN=http://127.0.0.1:8000

# The Supabase project behind sign-in and the saved-projects list. Both values
# are in the dashboard under Project Settings -> API.
#
# They are NEXT_PUBLIC_ because the browser talks to Supabase directly, and so
# both are visible to anyone who loads the site. That is by design: the anon key
# only names the project, and the row-level security in supabase/schema.sql is
# what stops one account reading another's manuscripts. Never put the
# service-role key in either of these — it belongs in the server-only variable
# further down.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Read by the Paddle webhook, which has no signed-in user to act as. It bypasses
# the row-level security in supabase/schema.sql, so it must never be named
# NEXT_PUBLIC_ — Next inlines those into the bundle every browser downloads, and
# this one would go with them. Project Settings -> API -> service_role.
#
# Only the webhook uses it, and only to write subscriptions. Leaving it unset
# disables checkout provisioning; nothing else in the app reads it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Paddle ---
#
# Subscriptions. The three NEXT_PUBLIC_ values are read by the browser and are
# public on purpose: the client token only identifies the seller account, and
# Paddle decides which origins may open a checkout with it.
#
# Developer Tools -> Authentication. `test_` for sandbox, `live_` for live.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_client_token

# "sandbox" or "production". Anything else is treated as sandbox, so a typo
# cannot quietly start charging real cards.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# The Pro plan's price. Catalog -> Products -> the price under the Pro plan.
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=pri_your_price_id

# The notification endpoint's signing secret (pdl_ntfset_...), from Developer
# Tools -> Notifications. Whoever holds this can forge a notification, and a
# forged transaction.completed is a free subscription — so it is server-only and
# must never be named NEXT_PUBLIC_.
#
# Without it the webhook refuses every delivery with a 500 rather than trusting
# an unsigned request, which means a checkout can be paid for and never
# provisioned.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_signing_secret
